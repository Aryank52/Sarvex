# ---------------------------------------------------------------------------
# SARVEX configuration. Copy to .env. Never commit .env.
# Values below are safe local-development defaults.
# ---------------------------------------------------------------------------
SARVEX_ENVIRONMENT=development
SARVEX_DEBUG=false

# Database: leave empty to use the SQLite dev fallback (no PostGIS).
# Production/compose: postgresql+psycopg2://sarvex:sarvex@db:5432/sarvex
DATABASE_URL=
REDIS_URL=

# Object storage: local | s3 (S3-compatible, e.g. MinIO)
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_DIR=./data/objects
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=sarvex
OBJECT_STORAGE_REGION=us-east-1

# Data access. Leave credentials empty for public/anonymous access.
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_EARTHDATA_TOKEN=
ASF_SEARCH_URL=https://api.daac.asf.alaska.edu/services/search/param
BHOONIDHI_BASE_URL=https://bhoonidhi.nrsc.gov.in
# Operator-supplied full search endpoint (authorized access only).
BHOONIDHI_SEARCH_URL=
BHOONIDHI_API_KEY=
STAC_SEARCH_URLS=

# Demo mode: auto | on | off
# auto = use live connectors when configured, otherwise fixtures (clearly labelled)
DEMO_MODE=auto
RUN_INLINE_WORKER=true
# Offline evaluation: skip live network probes but keep connectors explicit.
OFFLINE_MODE=false

# Models (see backend/config/models.yaml). Secrets are resolved from env vars
# named in the registry, never stored in YAML.
MODELS_CONFIG_PATH=config/models.yaml
LLM_API_KEY=
LLM_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
RERANKER_API_KEY=
RERANKER_BASE_URL=
EMBEDDING_DIMENSION=384

# Security / observability
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=512
RATE_LIMIT_PER_MINUTE=240
LOG_LEVEL=INFO
STRUCTURED_LOGS=true
